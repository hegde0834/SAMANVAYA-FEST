# Samanvaya 2.0 Environment Configuration Template

# Database Connection URL (PostgreSQL for Vercel / Neon / Supabase)
# Example Neon: postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example Supabase: postgresql://postgres:password@db.xxxxxx.supabase.co:5432/postgres?sslmode=require
# Example Vercel Postgres: automatically set by Vercel when connecting Postgres storage
DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# Admin dashboard secret key (Used to unlock /admin console)
ADMIN_SECRET="samanvaya2026admin"

# Base URL for public links
NEXT_PUBLIC_APP_URL="https://your-vercel-domain.vercel.app"

# Optional college email domain restriction (comma separated, e.g. "nie.ac.in,nieit.ac.in" or leave blank to allow all valid college emails)
COLLEGE_EMAIL_DOMAINS=""
